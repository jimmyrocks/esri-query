{
    "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "nodenext",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "isolatedModules": true,
        "target": "ES2022",
        "declaration": true,
        "declarationMap": true,
        "resolveJsonModule": true,
        "types": [
            "node"
        ],
        "noImplicitAny": true,
        "skipLibCheck": true,
        "sourceMap": false,
        "outDir": "dist",
        "rootDir": "src",
        "baseUrl": ".",
        "paths": {
            "better-sqlite3": [
                "node_modules/@types/better-sqlite3"
            ],
            "*": [
                "node_modules/*"
            ]
        }
    },
    "include": [
        "src/**/*.ts"
    ],
    "exclude": [
        "dist",
        "test",
        "src/**/*.unit.test.ts",
        "src/**/*.int.test.ts"
    ],
    "typedocOptions": {
        "entryPoints": [
            "src/index.ts"
        ],
        "out": "docs"
    }
}
