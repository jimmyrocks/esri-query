{
  "name": "esri-query",
  "version": "1.6.1",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "esri-query": "./dist/cli.js"
  },
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "EsriFeatureCollection.proto"
  ],
  "keywords": [
    "geopackage",
    "esri",
    "featureservice",
    "mapservice",
    "rest",
    "geojson",
    "geojsonsync"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jimmyrocks/esri-query.git"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "docs": "typedoc --plugin typedoc-plugin-markdown --out docs src/index.ts",
    "start": "npm run build && node --expose-gc ./dist/cli.js",
    "help": "node ./dist/cli.js --help",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test-full": "npm run build && node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "@dsnp/parquetjs": "^1.8.7",
    "@terraformer/arcgis": "^2.2.2",
    "@types/geojson": "^7946.0.16",
    "better-sqlite3": "12.11.1",
    "bottleneck": "^2.19.5",
    "cockatiel": "^4.0.0",
    "command-line-args": "^6.0.2",
    "flatgeobuf": "^4.4.0",
    "ky": "^2.0.2",
    "long": "^5.3.2",
    "protobufjs": "^8.7.0",
    "wkx": "^0.5.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@types/arcgis-rest-api": "^10.4.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/command-line-args": "^5.2.3",
    "@types/command-line-usage": "^5.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.0",
    "@types/sqlite3": "^5.1.0",
    "@types/terraformer__arcgis": "^2.0.5",
    "jest": "^30.4.2",
    "jest-ts-webcompat-resolver": "^1.0.1",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "6.0.3"
  }
}
